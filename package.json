{
  "name": "murdock",
  "version": "0.1.1",
  "description": "Paste a link, get an audio file. Vocal-stem sourcing tool for sampling.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "power": "MURDOCK_LOCAL=1 MURDOCK_COOKIES_BROWSER=opera MURDOCK_DOWNLOAD_DIR=$HOME/Downloads/murdock node --env-file-if-exists=.env.local server.js",
    "power:dev": "MURDOCK_LOCAL=1 MURDOCK_COOKIES_BROWSER=opera MURDOCK_DOWNLOAD_DIR=$HOME/Downloads/murdock node --env-file-if-exists=.env.local --watch server.js",
    "power:preview": "PORT=5759 MURDOCK_LOCAL=1 MURDOCK_COOKIES_BROWSER=opera MURDOCK_DOWNLOAD_DIR=$HOME/Downloads/murdock node --env-file-if-exists=.env.local server.js",
    "setup-stems": "bash scripts/setup-stems.sh",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
